# =====================================================================
#  CONFIGURACAO DO BOT DE OFERTAS  -  copie este arquivo para  ".env"
#  e preencha os valores.  Nunca compartilhe o .env: ele tem senhas.
# =====================================================================

# -------- TELEGRAM --------
# Token do seu bot, dado pelo @BotFather no Telegram.
TELEGRAM_BOT_TOKEN=

# Onde postar. Pode ser o @usuario do canal (ex: @minhasofertas)
# ou o ID numerico do canal (ex: -1001234567890).
TELEGRAM_CHANNEL=https://t.me/CanalTaBarato
# ID numerico da conversa privada que recebe o resumo diario (opcional).
TELEGRAM_ADMIN_ID=

# Hosts oficiais aceitos para baixar imagens antes de publicar no Bluesky.
# Amplie somente após confirmar que o domínio pertence ao marketplace/CDN.
IMAGEM_HOSTS_PERMITIDOS=cf.shopee.com.br,img.susercontent.com,aliexpress-media.com,alicdn.com,m.media-amazon.com,images-na.ssl-images-amazon.com,http2.mlstatic.com,mla-s2-p.mlstatic.com

# -------- FACEBOOK PAGE (opcional; comeca desligado) --------
# O token precisa pertencer a pagina e ter pages_manage_posts.
FACEBOOK_ATIVO=false
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v26.0
FACEBOOK_TRACKING_ID=facebook
# 0 = ilimitado (o limite geral de ofertas por dia continua valendo)
FACEBOOK_MAX_POSTS_DIA=4

# -------- BUFFER (FACEBOOK E X) --------
BUFFER_API_KEY=
BUFFER_X_API_KEY=
BUFFER_FACEBOOK_CHANNEL_ID=
BUFFER_X_CHANNEL_ID=

# -------- SHOPEE (API de afiliado) --------
# Pegue em: https://affiliate.shopee.com.br/open_api
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_ATIVA=true
PESO_SHOPEE=1
PERCENTUAL_SHOPEE=30

# Uma "etiqueta" de rastreio que aparece nos seus relatorios (opcional).
SHOPEE_SUBID=telegram
SHOPEE_VIP_URL=
SHOPEE_VIP_ATIVO=true
# 0=segunda, 1=terça ... 6=domingo
SHOPEE_VIP_DIAS=0,2,5
SHOPEE_VIP_HORAS=10,11,19,20

# -------- AMAZON (lista publica do perfil de influenciador) --------
# Tudo que voce adicionar nesta lista entra automaticamente na fila do bot.
AMAZON_LIST_URL=https://www.amazon.com.br/shop/emersonpettor/list/2ZUSMM2BR8LVZ?ref_=aipsflist
AMAZON_ASSOCIATE_TAG=canaltabarato-20
AMAZON_LIST_SOURCE_TAGS=emersonpettor-20
AMAZON_FETCH_LIMIT=100
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_ATIVA=true
PESO_AMAZON=1
PERCENTUAL_AMAZON=25

# -------- MERCADO LIVRE (lista publica de recomendacoes) --------
# Tudo que voce adicionar nesta lista entra automaticamente na fila do bot.
MERCADOLIVRE_LIST_URL=https://meli.la/2nNpgzg
MERCADOLIVRE_ATIVA=true
PESO_MERCADOLIVRE=1
PERCENTUAL_MERCADOLIVRE=30
MERCADOLIVRE_FETCH_LIMIT=150

# -------- ALIEXPRESS (API de afiliado) --------
# Cadastre-se em portals.aliexpress.com e peca acesso a API.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ATIVA=true
PERCENTUAL_ALIEXPRESS=15
PESO_ALIEXPRESS=1
ALIEXPRESS_TRACKING_ID=telegram
ALIEXPRESS_KEYWORD=
ALIEXPRESS_SORT=LAST_VOLUME_DESC
ALIEXPRESS_FETCH_LIMIT=40
ALIEXPRESS_SHIP_TO=BR
ALIEXPRESS_CURRENCY=BRL
ALIEXPRESS_LANGUAGE=pt

# =====================================================================
#  FILTROS - o que conta como "boa oferta". Ajuste como quiser.
# =====================================================================

# Desconto minimo em % para postar (ex: 20 = so posta com 20%+ off).
MIN_DISCOUNT=15
DESCONTO_PREFERIDO=30

# Nota minima do produto, de 0 a 5 (ex: 4.5).
MIN_RATING=4.5

# Vendas minimas do produto (prova de que e confiavel).
MIN_SALES=50
VENDAS_EXCECAO_DESCONTO=1000
QUEDA_PRECO_REPOST_PERCENT=15

# Como ordenar as ofertas buscadas:
#   2 = mais vendidos   5 = maior comissao   1 = mais relevantes
SHOPEE_SORT_TYPE=2

# Palavra-chave para focar a busca (deixe vazio para pegar de tudo).
SHOPEE_KEYWORD=

# =====================================================================
#  RITMO das postagens
# =====================================================================

# De quantos em quantos minutos o bot procura ofertas novas.
POLL_INTERVAL_MINUTES=30
# Na nuvem, o cron consulta com frequência e estes intervalos decidem quando postar.
MIN_MINUTOS_ENTRE_POSTS=15
MAX_MINUTOS_ENTRE_POSTS=15
MIN_MINUTOS_FORA_PICO=30
MAX_MINUTOS_FORA_PICO=30
HTTP_MAX_TENTATIVAS=3
RELATORIO_HORA=11
RELATORIO_MINUTO=30
RELATORIO_ALERTA_MIN_POSTS=10

# Quantas ofertas, no maximo, postar a cada rodada.
MAX_POSTS_PER_RUN=3
PICO_PRIORIZA_MAIS_VENDIDOS=false
PICO_JANELA_VENDAS_DIAS=7
SITE_ATIVO=false
SITE_API_URL=https://canaltabarato.com.br/api/publish
SHORTLINK_API_URL=https://go.canaltabarato.com.br
SHORTLINK_BASE_URL=https://go.canaltabarato.com.br
SHORTLINK_API_TOKEN=
SITE_API_TOKEN=
SITE_TRACKING_ID=site
SITE_REFRESH_PER_RUN=6
# Cria no painel um comparativo por dia, sempre como rascunho.
BLOG_RASCUNHO_AUTOMATICO=true
# Intervalo em minutos quando a mesma rodada enviar mais de uma oferta.
INTERVALO_ENTRE_POSTS_MINUTOS=3
MAX_POSTS_POR_DIA=50
MAX_POSTS_POR_LOJA_DIA=3
MAX_POSTS_CONSECUTIVOS_FONTE=3
DIVERSIDADE_JANELA_POSTS=3
SIMILARIDADE_MAXIMA=0.68
DIAS_BLOQUEIO_PRODUTO_SEMELHANTE=3
TITULO_MAX_CARACTERES=90
DESEMPENHO_MAX_DIAS=14
AB_TEST_ATIVO=false
CHAMADAS_HUMANAS_ATIVAS=false
AB_TEST_NOME=chamada_humana_v1
FALHAS_CONSECUTIVAS_ALERTA=3

# Segundos de espera entre uma postagem e outra.
DELAY_BETWEEN_POSTS_SECONDS=5

# Quantos produtos buscar na API por rodada (para depois filtrar).
SHOPEE_FETCH_LIMIT=50
