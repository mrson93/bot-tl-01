{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bot-tl-01",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": []
  },
  "vars": {
    "GITHUB_OWNER": "mrson93",
    "GITHUB_REPO": "bot-tl-01",
    "GITHUB_DEFAULT_BRANCH": "main",
    "USAGE_MONITOR_ENABLED": "true",
    "MONITOR_ATIVO": "true",
    "MONITOR_INTERVALO_HORAS": "2",
    "MONITOR_DIAS_HISTORICO": "90"
  },
  "d1_databases": [
    {
      "binding": "MONITOR_DB",
      "database_name": "canaltabarato-ofertas",
      "database_id": "42b47ea8-6839-420e-9036-eb9fd057b0df"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
