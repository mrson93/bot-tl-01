name = "deal-signal-control"
main = "src/index.js"
compatibility_date = "2026-09-06"
compatibility_flags = ["nodejs_compat"]
workers_dev = true
preview_urls = false

# O Worker dedicado scheduler é a única origem das consultas periódicas.
[triggers]
crons = []

[vars]
GITHUB_OWNER = "SEU_USUARIO_GITHUB"
GITHUB_REPO = "SEU_REPOSITORIO"
GITHUB_DEFAULT_BRANCH = "main"

[observability]
enabled = true

[observability.logs]
head_sampling_rate = 1

# Configure exclusivamente com `wrangler secret put`:
# TELEGRAM_BOT_TOKEN
# TELEGRAM_ADMIN_ID
# TELEGRAM_WEBHOOK_SECRET
# GITHUB_TOKEN
# SCHEDULER_SHARED_SECRET (mesmo valor secreto no Worker agendador)
