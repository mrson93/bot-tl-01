{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bot-tl-01-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "services": [
    {
      "binding": "CONTROLLER",
      "service": "bot-tl-01"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
